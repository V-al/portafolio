---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

import fondoVal from "../assets/Val.jpg";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main
			class="fondo_inicio"
			style={`background-image: url(${fondoVal.src});`}
		>
			<div class="hero-content">
				<h1>Val <br /> Aguilera</h1>
			</div>
		</main>
		<Footer />
	</body>
</html>
<style is:global>
	/* Asegúrate de que el body no tenga márgenes predeterminados */
	body {
		margin: 0;
		padding: 0;
		width: 100vw;
		height: 100vh; /* Altura completa de la ventana del navegador */
		overflow-x: hidden; /* Evita barras de desplazamiento si es necesario */
	}

	.fondo_inicio {
		background-image: url("../assets/Val.jpg");
		background-size: cover; /* Cubre todo el div sin deformarse */
		background-position: center;
		background-repeat: no-repeat;
		width: 100%;
		height: 100%;

		/* Opcional: Centrar el contenido dentro de .fondo_inicio */
		display: flex;
		flex-direction: column;
		justify-content: center; /* Centrado vertical */
		align-items: center; /* Centrado horizontal */
	}

	h1 {
		color: white;
		font-size: 4rem;
		text-align: left;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
		/* margin: 0; */
		position: absolute;
		right: 15%;
		top: 47%;
	}
	@media (orientation: portrait) {
		.fondo_inicio {
			justify-content: center; /* Centra el texto en pantallas pequeñas */
			padding: 2rem 1.2rem; /* Reduce el espacio en los laterales */
			text-align: center;
		}

		h1 {
			width: 200px;

			right: 20%;
			font-size: 3rem;
		}
	}
</style>
