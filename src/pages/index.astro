---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

import fondoVal from "../assets/Val.jpg";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main
			class="fondo_inicio"
			style={`background-image: url(${fondoVal.src});`}
		>
			<div class="hero-content">
				<h1 id="hero-title">Val <br /> Aguilera</h1>
			</div>
			<div class="text-main"></div>
		</main>
		<Footer />
		<script>
			function setupScrollEffect() {
				const heroTitle = document.getElementById("hero-title");
				if (!heroTitle) return;

				window.addEventListener("scroll", () => {
					// Si se baja más de 120px de scroll, oculta el h1
					if (window.scrollY > 70) {
						heroTitle.classList.add("hidden");
					} else {
						heroTitle.classList.remove("hidden");
					}
				});
			}

			setupScrollEffect();
			document.addEventListener("astro:after-swap", setupScrollEffect);
		</script>
	</body>
</html>
<style is:global>
	body {
		margin: 0;
		padding: 0;
		width: 100vw;
		height: 100vh;
		background-color: #0c0d21;
		overflow-x: hidden;
	}

	.fondo_inicio {
		background-image: url(/src/assets/Val.jpg);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		width: 100%;
		position: relative;
		top: -11%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	h1 {
		color: white;
		font-family: "Unbounded", sans-serif;
		font-size: 4rem;
		text-align: left;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
		/* margin: 0; */
		position: fixed;
		right: 15%;
		top: 47%;
		/* Transición añadida */
		opacity: 1;
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}
	.text-main {
		color: #fff;
	}
	h1.hidden {
		opacity: 0;
		pointer-events: none;
	}

	@media (orientation: portrait) {
		.fondo_inicio {
			justify-content: center; /* Centra el texto en pantallas pequeñas */
			padding: 2rem 1.2rem; /* Reduce el espacio en los laterales */
			text-align: center;
		}

		h1 {
			width: 200px;
			right: 20%;
			font-size: 2.2rem;
		}
	}
</style>
